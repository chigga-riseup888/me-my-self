INCLUDE_SEC_DISABLE_DDNS_WEAK_TLS_CIPHERS=y
INCLUDE_DDNS_TLS_CIPHER_LIST="ALL:!RSA:!aNULL:!eNULL:HIGH:!PSK:!DSS:!SHA1:!AESCCM8:!ARIA:@STRENGTH"
INCLUDE_DDNS_TLS_SIGALGS_LIST="rsa_pss_rsae_sha256:rsa_pss_rsae_sha384:rsa_pss_rsae_sha512:ecdsa_secp256r1_sha256:ecdsa_secp384r1_sha384:ecdsa_secp521r1_sha512:rsa_pss_pss_sha256:rsa_pss_pss_sha384:rsa_pss_pss_sha512:rsa_pkcs1_sha256:rsa_pkcs1_sha384:rsa_pkcs1_sha512"
INCLUDE_DDNS_TLS_GROUPS_LIST="P-521:P-384:P-256"
# INCLUDE_SHOW_INFORMATION_FOR_USER is not set
# INCLUDE_QS_AUTOUPDATE_ENABLE_FROM_DM is not set
INCLUDE_BACKUP_RESTORE_WITH_PASSWORD=y
INCLUDE_CONFIG_BACKUP_RESTORE_WITH_PASSWORD_FORCE=y
INCLUDE_CONFIG_PASSWD_FAIL_WAIT_TIME="2"
